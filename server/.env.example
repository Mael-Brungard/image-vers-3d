# Configuration du serveur de licences. Copie ce fichier en « .env » (jamais commité) et remplis les valeurs.
# Tout ce qui est secret ne vit QUE dans ce fichier, sur le serveur.

# --- Obligatoire -------------------------------------------------------------------------------------------------
# Nom de domaine public (son DNS pointe vers le serveur) et adresse publique complète.
I3D_DOMAIN=licence.exemple.fr
I3D_BASE_URL=https://licence.exemple.fr

# Clé PRIVÉE de signature : python -m licenseserver.admin genkey   (la clé PUBLIQUE va dans la variable de dépôt I3D_LICENSE_PUBKEYS)
I3D_SIGNING_KEY=
I3D_SIGNING_KID=k1

# Secret maître (32 caractères aléatoires minimum) : en dérivent la clé de licence affichée, l'empreinte de recherche et les sessions.
# Générer : python -c "import secrets; print(secrets.token_urlsafe(48))"
# Le PERDRE ou le CHANGER rend toutes les clés de licence déjà vendues introuvables : sauvegarde-le avec la clé de signature.
I3D_MASTER_SECRET=

# --- Paiement (Stripe) -------------------------------------------------------------------------------------------
# Secret du point d'accès webhook (« whsec_… »), créé dans Stripe > Développeurs > Webhooks, URL : https://<domaine>/stripe/webhook
# Événements à cocher : checkout.session.completed, checkout.session.async_payment_succeeded, charge.refunded, charge.dispute.created
STRIPE_WEBHOOK_SECRET=
# Facultatif : n'accepter que les paiements de CE lien de paiement (« plink_… ») ; vide = tous les paiements du compte.
I3D_STRIPE_PAYMENT_LINK_ID=

# --- E-mails (code de connexion à l'espace client, envoi de la clé après achat) ----------------------------------
I3D_MAIL_BACKEND=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Image vers 3D <licence@exemple.fr>

# --- Affichage (facultatif) --------------------------------------------------------------------------------------
I3D_SUPPORT_EMAIL=support@exemple.fr
I3D_PRODUCT_NAME=Image vers 3D
I3D_DOWNLOAD_URL=
I3D_BUY_URL=

# --- Règles (valeurs par défaut conseillées) ---------------------------------------------------------------------
I3D_MAX_DEVICES=2
I3D_TRANSFERS_PER_YEAR=3
I3D_TRIAL_PER_IP_PER_MONTH=5
